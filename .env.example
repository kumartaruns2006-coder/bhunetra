# ==========================================================
# BhuNetra Environment Configuration
# ==========================================================

# 1. OPTIONAL CLOUD DATABASE (Supabase / PostgreSQL)
# If provided, BhuNetra automatically syncs data to the cloud database.
# If omitted, BhuNetra runs in standalone local mode with localStorage.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 2. OPTIONAL BACKEND REST API (Custom Node.js / FastAPI Server)
# VITE_API_URL=https://api.bhunetra.nic.in/v1

# 3. STATUTORY GEOPORTAL ENVIRONMENT
VITE_APP_ENV=production
